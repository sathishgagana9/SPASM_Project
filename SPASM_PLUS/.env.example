# Copy to .env and fill in as needed. Never commit the real .env file.

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./spasm.db

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM Provider ---
# Groq is the only provider — Ollama support was removed entirely.
# Create a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=

# --- Drift severity thresholds (PROVISIONAL, see docs/drift-detection.md) ---
DRIFT_SEVERITY_LOW_THRESHOLD=0.85
DRIFT_SEVERITY_MEDIUM_THRESHOLD=0.70
DRIFT_SEVERITY_HIGH_THRESHOLD=0.50

# --- SPASM++ research evaluation ---
# Primary research conformal path requires real sentence embeddings.
# Use SPASM_SEMANTIC_BACKEND=lexical only for the explicit lexical baseline.
SPASM_SEMANTIC_BACKEND=embeddings
# Sentence-transformers model used by the shared semantic backend.
SPASM_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Sequential conformal defaults used by research experiments.
SPASM_SEQ_ALPHA=0.05
SPASM_SEQ_EPSILON=0.5
SPASM_FDR_Q=0.05
